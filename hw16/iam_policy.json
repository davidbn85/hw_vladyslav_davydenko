{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowListSpecificBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::vlad-hw16-489287384593-489287384593-eu-central-1-an"
            ]
        },
        {
            "Sid": "AllowManageObjectsInSpecificBucket",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::vlad-hw16-489287384593-489287384593-eu-central-1-an/*"
            ]
        }
    ]
}